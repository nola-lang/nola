import { placeOrder, requestQuote } from "./handlers.js";
import type { OrderRequest } from "./types.js";

const inbox = [
  `From: dana.reyes@acme-robotics.com
Subject: PO for actuators

Hi — Dana Reyes at Acme Robotics here. We need 12 CX-3 linear actuators and
4 mounting kits shipped to our plant at 500 Harbor Blvd, Oakland, 94607.
We must have them on site by September 30, 2026 — rush it if you have to.

Thanks, Dana`,
  `From: priya@northwind-labs.io
Subject: quote?

Hello — could you put together a quote for roughly 200 units of the M8
temperature sensor bundle?

Best, Priya Sharma`,
];

for (const .email of inbox) {
  const kind = ask `is this email placing an order or asking for a quote`<"order" | "quote">;
  if (kind === "order") {
    const order = ask `the order request described in the email`<OrderRequest>;
    console.log(placeOrder(order));
  } else {
    console.log(ask requestQuote(
      ..`one line describing what the customer wants quoted`<string>,
      ..`the customer's name`<string>,
    ));
  }
}
