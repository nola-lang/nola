{
  "name": "@nola-lang/browser",
  "version": "0.1.15",
  "description": "Browser hosts for Nola: a layout-preserving type strip with the loader's debug map, blob modules and the runtime import rewrite — TypeScript injected, never imported",
  "keywords": [
    "nola"
  ],
  "license": "Apache-2.0",
  "author": "Evgen Mykhailenko",
  "homepage": "https://github.com/nola-lang/nola#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nola-lang/nola.git",
    "directory": "packages/browser"
  },
  "bugs": {
    "url": "https://github.com/nola-lang/nola/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "dependencies": {
    "@ampproject/remapping": "^2.3.0",
    "@jridgewell/sourcemap-codec": "^1.5.0",
    "@nola-lang/ast": "0.1.15",
    "@nola-lang/compiler": "0.1.15",
    "@nola-lang/core": "0.1.15"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.3"
  }
}
