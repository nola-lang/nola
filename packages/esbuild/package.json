{
  "name": "@nola-lang/esbuild",
  "version": "0.1.3",
  "description": "esbuild plugin for Nola (.tsi) — also covers tsup",
  "keywords": [
    "nola",
    "esbuild",
    "esbuild-plugin",
    "tsup",
    "llm",
    "ai"
  ],
  "license": "Apache-2.0",
  "author": "Evgen Mykhailenko",
  "homepage": "https://github.com/nola-lang/nola#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nola-lang/nola.git",
    "directory": "packages/esbuild"
  },
  "bugs": {
    "url": "https://github.com/nola-lang/nola/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
