{
  "name": "@nola-lang/derive",
  "version": "0.1.12",
  "description": "Checker-backed schema derivation for Nola: the TypeScript walk and the per-process language service",
  "keywords": [
    "nola"
  ],
  "license": "Apache-2.0",
  "author": "Evgen Mykhailenko",
  "homepage": "https://github.com/nola-lang/nola#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nola-lang/nola.git",
    "directory": "packages/derive"
  },
  "bugs": {
    "url": "https://github.com/nola-lang/nola/issues"
  },
  "publishConfig": {
    "access": "public"
