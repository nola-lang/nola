{
  "name": "nola-lang",
  "version": "0.1.4",
  "description": "The Nola language toolchain: nola init/build/run/check and the Node loader for .tsi files",
  "keywords": [
    "nola",
    "llm",
    "ai",
    "typescript",
    "language",
    "prompt",
    "cli"
  ],
  "license": "Apache-2.0",
  "author": "Evgen Mykhailenko",
  "homepage": "https://github.com/nola-lang/nola#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nola-lang/nola.git",
    "directory": "packages/nola-lang"
  },
  "bugs": {
    "url": "https://github.com/nola-lang/nola/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "nola": "dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": "./dist/register.js"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "dependencies": {
    "@ampproject/remapping": "^2.3.0",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@nola-lang/ast": "0.1.4",
    "@nola-lang/compiler": "0.1.4",
    "@nola-lang/node-loader": "0.1.4",
    "@nola-lang/parser": "0.1.4",
    "@nola-lang/runtime": "0.1.4",
    "create-nola-lang": "0.1.4",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
