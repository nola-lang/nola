{
  "name": "@nola-lang/webpack",
  "version": "0.1.2",
  "description": "webpack plugin for Nola (.tsi)",
  "keywords": [
    "nola",
    "webpack",
    "webpack-plugin",
    "llm",
    "ai"
  ],
  "license": "Apache-2.0",
  "author": "Evgen Mykhailenko",
  "homepage": "https://github.com/nola-lang/nola#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nola-lang/nola.git",
    "directory": "packages/webpack"
  },
  "bugs": {
    "url": "https://github.com/nola-lang/nola/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "dependencies": {
    "@nola-lang/unplugin": "0.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
