{
  "name": "@nola-lang/language-server",
  "version": "0.1.1",
  "description": "Nola language server (LSP) for editors beyond VS Code",
  "keywords": [
    "nola",
    "lsp",
    "language-server"
  ],
  "license": "Apache-2.0",
  "author": "Evgen Mykhailenko",
  "homepage": "https://github.com/nola-lang/nola#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nola-lang/nola.git",
    "directory": "packages/language-server"
  },
  "bugs": {
    "url": "https://github.com/nola-lang/nola/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server.cjs": "./dist/server.cjs"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "@nola-lang/ast": "0.1.1",
    "@nola-lang/compiler": "0.1.1",
    "@nola-lang/language-core": "0.1.1",
    "@nola-lang/node-loader": "0.1.1",
    "@nola-lang/typescript-plugin": "0.1.1",
    "@volar/language-server": "2.4.28",
    "volar-service-typescript": "0.0.71",
    "vscode-uri": "^3.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
