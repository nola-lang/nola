export infer function solve(.problem: string) {
  // First ask: untyped, returns free-text reasoning.
  const reasoning = ask ..`think step by step about the problem before answering`;
  // Second ask: the reasoning flows into the prompt through plain `${}`
  // interpolation, so the typed answer is extracted with it in view.
  const answer = ask ..`given this reasoning: ${reasoning} — the final numeric answer`<number>;
  return { reasoning, answer };
}
