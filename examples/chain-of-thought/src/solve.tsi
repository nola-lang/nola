export infer function solve(.problem: string) {
  // First ask: untyped, returns free-text reasoning.
  const reasoning = ask `think step by step about the problem before answering`;
  // A context statement — text, then a value — puts the reasoning in front of
  // every ask below it. It is read when that ask runs.
  `Reasoning so far:` reasoning;
  // Second ask: the typed answer is extracted with the reasoning in view.
  const answer = ask `the final numeric answer`: number;
  return { reasoning, answer };
}
